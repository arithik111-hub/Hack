generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum AnimeStatus {
  AIRING
  COMPLETED
  UPCOMING
}

enum AnimeMetadataSource {
  MANUAL
  ANILIST
  JIKAN
  KITSU
}

enum SourceType {
  EMBED
  HLS
  MP4
  OTHER
}

enum MediaJobStatus {
  QUEUED
  DOWNLOADING
  UPLOADING
  PAUSED
  FAILED
  CANCELLED
  SUCCEEDED
}

enum VideoProvider {
  CLOUDFLARE_STREAM
  BUNNY_STREAM
  MUX
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  image        String?
  role         UserRole       @default(USER)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  watchHistory WatchHistory[]
  watchlist    Watchlist[]
  favorites    Favorite[]
  mediaJobs    MediaIngestionJob[]

  @@index([role])
  @@index([createdAt])
}

model Anime {
  id                 String              @id @default(cuid())
  anilistId          Int?                @unique
  jikanId            Int?                @unique
  kitsuId            String?             @unique
  slug               String              @unique
  title              String
  romajiTitle        String?
  japaneseTitle      String?
  alternativeTitle   String?
  description        String              @db.Text
  poster             String
  banner             String
  customPoster       Boolean             @default(false)
  rating             Float               @default(0)
  releaseYear        Int
  season             String?
  durationMinutes    Int?
  sourceMaterial     String?
  officialWebsite    String?
  studio             String
  status             AnimeStatus         @default(COMPLETED)
  type               String              @default("TV")
  languages          String[]
  totalEpisodes      Int?
  featured           Boolean             @default(false)
  trending           Boolean             @default(false)
  published          Boolean             @default(true)
  popularity         Int                 @default(0)
  metadataSource     AnimeMetadataSource @default(MANUAL)
  lastSyncedAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  genres             AnimeGenre[]
  seasons            Season[]
  episodes           Episode[]
  mediaJobs          MediaIngestionJob[]
  watchlist          Watchlist[]
  favorites          Favorite[]

  @@index([published, status])
  @@index([releaseYear])
  @@index([featured, trending])
  @@index([createdAt])
  @@index([popularity])
  @@index([rating])
}

model Genre {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  animes    AnimeGenre[]

  @@index([slug])
}

model AnimeGenre {
  animeId String
  genreId String
  anime   Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
  @@index([genreId])
}

model Season {
  id           String    @id @default(cuid())
  animeId      String
  seasonNumber Int
  title        String
  episodeCount Int       @default(0)
  releaseYear  Int?
  anime        Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodes     Episode[]
  mediaJobs    MediaIngestionJob[]

  @@unique([animeId, seasonNumber])
  @@index([animeId])
}

model Episode {
  id              String         @id @default(cuid())
  animeId         String
  seasonId        String
  episodeNumber   Int
  title           String
  description     String         @db.Text
  thumbnail       String
  duration        Int
  releaseDate     DateTime
  published       Boolean        @default(true)
  anime           Anime          @relation(fields: [animeId], references: [id], onDelete: Cascade)
  season          Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  videoSources    VideoSource[]
  watchHistory    WatchHistory[]
  mediaJobs       MediaIngestionJob[]

  @@unique([seasonId, episodeNumber])
  @@index([animeId, published])
  @@index([seasonId, episodeNumber])
}

model VideoSource {
  id                String     @id @default(cuid())
  episodeId         String
  provider          String
  sourceType        SourceType @default(EMBED)
  playbackReference String     @db.Text
  isActive          Boolean    @default(false)
  language          String?
  providerAssetId   String?
  fileSize          Int?
  durationSeconds   Int?
  ingestionJobId    String?    @unique
  episode           Episode    @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  ingestionJob      MediaIngestionJob? @relation(fields: [ingestionJobId], references: [id], onDelete: SetNull)

  @@index([episodeId, isActive])
}

model MediaIngestionJob {
  id                       String         @id @default(cuid())
  animeId                  String
  seasonId                 String
  episodeId                String
  createdById              String
  language                 String
  provider                 VideoProvider
  status                   MediaJobStatus @default(QUEUED)
  encryptedSourceUrl       String         @db.Text
  sourceHost               String
  authorizationNote        String         @db.Text
  authorizationConfirmedAt DateTime       @default(now())
  dedupeKey                String         @unique
  downloadProgress         Int             @default(0)
  uploadProgress           Int             @default(0)
  downloadedBytes          Int             @default(0)
  fileSize                 Int?
  providerAssetId          String?
  playbackReference        String?         @db.Text
  attempts                 Int             @default(0)
  errorMessage             String?         @db.Text
  workerId                 String?
  leaseExpiresAt           DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  anime                    Anime           @relation(fields: [animeId], references: [id], onDelete: Restrict)
  season                   Season          @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  episode                  Episode          @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  createdBy                User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  videoSource              VideoSource?

  @@index([status, createdAt])
  @@index([workerId, leaseExpiresAt])
  @@index([episodeId, createdAt])
}

model WatchHistory {
  id             String   @id @default(cuid())
  userId         String
  episodeId      String
  progressSeconds Int      @default(0)
  completed      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode        Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, updatedAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([animeId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([animeId])
}
